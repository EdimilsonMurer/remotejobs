# ============================================================================
# REMOTEJOBS PT - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE
# ============================================================================

# --- GOOGLE GEMINI AI (Obrigatório para classificação das vagas) ---
# Obtido gratuitamente no Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY="seu_gemini_api_key_aqui"

# --- SUPABASE (Obrigatório para persistência de dados e autenticação) ---
# Obtido nas configurações do seu projeto Supabase (Project Settings > API)
# No Vercel, cadastre tanto com prefixo VITE_ quanto sem para acesso universal:
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anonima-publica"
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_ANON_KEY="sua-chave-anonima-publica"

# --- SUPABASE SERVICE ROLE (Apenas para backend/scripts/GitHub Actions/Vercel Serverless) ---
# NUNCA expor no frontend ou versionar no Git!
SUPABASE_SERVICE_ROLE_KEY="sua-chave-service-role-admin"

# --- VERCEL CRON SECRET (Opcional - para proteção do endpoint /api/cron) ---
CRON_SECRET=""

# --- APP URL ---
APP_URL="http://localhost:3000"
